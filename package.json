{
  "name": "@ramezjamal/seo-module",
  "version": "0.1.0",
  "description": "Configurable SEO helpers for Next.js App Router: metadata, canonicals, hreflang, robots, sitemaps, and JSON-LD.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramezjamal/seo-module.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "files": [
    "dist",
    "README.md",
    "EXTRACTION.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test tests/seo.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.3",
    "next": "^16.2.10",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
